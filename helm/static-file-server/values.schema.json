{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "static-file-server Helm chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "boolish": {
      "description": "A boolean, or its quoted form rendered into an environment variable.",
      "type": [
        "boolean",
        "string"
      ],
      "enum": [
        true,
        false,
        "true",
        "false"
      ]
    },
    "port": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        {
          "type": "string",
          "pattern": "^([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
        }
      ]
    },
    "portOrName": {
      "anyOf": [
        {
          "$ref": "#/definitions/port"
        },
        {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 15
        }
      ]
    },
    "bytes": {
      "description": "A whole number of bytes as a quoted string; empty means unlimited. Quote it: Helm renders a large unquoted number in exponent form.",
      "type": "string",
      "pattern": "^[0-9]*$"
    },
    "duration": {
      "description": "A Go duration such as 336h; empty means none.",
      "type": "string",
      "pattern": "^$|^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
    },
    "optionalPositiveInt": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "pattern": "^[0-9]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "intOrPercent": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^$|^[0-9]+%?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "accessMode": {
      "type": "string",
      "enum": [
        "ReadWriteOnce",
        "ReadOnlyMany",
        "ReadWriteMany",
        "ReadWriteOncePod"
      ]
    },
    "serviceType": {
      "type": "string",
      "enum": [
        "ClusterIP",
        "NodePort",
        "LoadBalancer"
      ]
    }
  },
  "properties": {
    "global": {
      "type": "object"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "tag": {
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "required": [
        "repository"
      ]
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "automount": {
          "type": "boolean"
        }
      }
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": [
        "object",
        "null"
      ]
    },
    "securityContext": {
      "type": [
        "object",
        "null"
      ]
    },
    "enableServiceLinks": {
      "type": "boolean"
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "folder": {
          "type": "string"
        },
        "port": {
          "$ref": "#/definitions/port"
        },
        "cors": {
          "$ref": "#/definitions/boolish"
        },
        "debug": {
          "$ref": "#/definitions/boolish"
        },
        "allowIndex": {
          "$ref": "#/definitions/boolish"
        },
        "showListing": {
          "$ref": "#/definitions/boolish"
        },
        "urlPrefix": {
          "type": "string",
          "pattern": "^$|^/.*[^/]$"
        },
        "tlsCert": {
          "type": "string"
        },
        "tlsKey": {
          "type": "string"
        },
        "tlsMinVers": {
          "type": "string",
          "enum": [
            "",
            "TLS11",
            "TLS12",
            "TLS13",
            "tls11",
            "tls12",
            "tls13"
          ]
        },
        "referrers": {
          "type": "string"
        },
        "accessKey": {
          "type": "string"
        },
        "customHeaders": {
          "type": "string"
        },
        "spa": {
          "$ref": "#/definitions/boolish"
        },
        "compression": {
          "$ref": "#/definitions/boolish"
        },
        "hideDotFiles": {
          "$ref": "#/definitions/boolish"
        },
        "logFormat": {
          "type": "string",
          "enum": [
            "text",
            "json"
          ]
        },
        "metrics": {
          "$ref": "#/definitions/boolish"
        }
      }
    },
    "extraEnv": {
      "type": "array"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/definitions/serviceType"
        },
        "port": {
          "$ref": "#/definitions/port"
        },
        "annotations": {
          "type": "object"
        },
        "targetPort": {
          "description": "Deprecated since 0.10.0 and ignored: the Service always targets the named port http."
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": [
            "object",
            "null"
          ]
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "host": {
                "type": "string"
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "pathType": {
                      "type": "string",
                      "enum": [
                        "Prefix",
                        "Exact",
                        "ImplementationSpecific"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array"
        }
      }
    },
    "httproute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "namespace": {
                "type": "string"
              },
              "sectionName": {
                "type": "string"
              },
              "port": {
                "$ref": "#/definitions/port"
              }
            }
          },
          "minItems": 1
        },
        "hostnames": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "matches": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "PathPrefix",
                            "Exact",
                            "RegularExpression"
                          ]
                        },
                        "value": {
                          "type": "string"
                        }
                      }
                    },
                    "headers": {
                      "type": [
                        "array",
                        "null"
                      ]
                    },
                    "queryParams": {
                      "type": [
                        "array",
                        "null"
                      ]
                    },
                    "method": {
                      "type": "string"
                    }
                  }
                }
              },
              "filters": {
                "type": [
                  "array",
                  "null"
                ]
              },
              "timeouts": {
                "type": "object"
              },
              "backendRefs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "port": {
                      "$ref": "#/definitions/port"
                    },
                    "weight": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        },
        "httpsRedirect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "statusCode": {
              "type": "integer",
              "enum": [
                301,
                302,
                307,
                308
              ]
            },
            "port": {
              "$ref": "#/definitions/port"
            },
            "parentRefs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "namespace": {
                    "type": "string"
                  },
                  "sectionName": {
                    "type": "string"
                  },
                  "port": {
                    "$ref": "#/definitions/port"
                  }
                }
              },
              "minItems": 1
            }
          }
        }
      }
    },
    "resources": {
      "type": [
        "object",
        "null"
      ]
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "liveness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "path": {
              "type": "string"
            },
            "port": {
              "$ref": "#/definitions/portOrName"
            },
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "$ref": "#/definitions/optionalPositiveInt"
            },
            "failureThreshold": {
              "$ref": "#/definitions/optionalPositiveInt"
            }
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "path": {
              "type": "string"
            },
            "port": {
              "$ref": "#/definitions/portOrName"
            },
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "$ref": "#/definitions/optionalPositiveInt"
            },
            "failureThreshold": {
              "$ref": "#/definitions/optionalPositiveInt"
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "accessMode": {
          "$ref": "#/definitions/accessMode"
        },
        "size": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "existingClaim": {
          "type": "string"
        }
      }
    },
    "persistentVolumes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        }
      }
    },
    "persistentVolumeClaims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    },
    "mode": {
      "type": "string",
      "enum": [
        "",
        "all",
        "cache"
      ]
    },
    "s3Cache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "$ref": "#/definitions/port"
        },
        "folder": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "accessKeyKey": {
          "type": "string"
        },
        "secretKeyKey": {
          "type": "string"
        },
        "buckets": {
          "type": "string"
        },
        "ttl": {
          "$ref": "#/definitions/duration"
        },
        "maxObjectSize": {
          "$ref": "#/definitions/bytes"
        },
        "maxTotalSize": {
          "$ref": "#/definitions/bytes"
        },
        "existingClaim": {
          "type": "string"
        },
        "subPath": {
          "type": "string"
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "storageClass": {
              "type": "string"
            },
            "accessMode": {
              "$ref": "#/definitions/accessMode"
            },
            "size": {
              "type": "string"
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "$ref": "#/definitions/serviceType"
            },
            "port": {
              "$ref": "#/definitions/port"
            },
            "annotations": {
              "type": "object"
            }
          }
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "labels": {
          "type": "object"
        },
        "interval": {
          "type": "string"
        },
        "scrapeTimeout": {
          "type": "string"
        },
        "tlsConfig": {
          "type": "object"
        }
      }
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array"
    },
    "strategy": {
      "type": "object"
    },
    "priorityClassName": {
      "type": "string"
    },
    "terminationGracePeriodSeconds": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^[0-9]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string"
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "$ref": "#/definitions/intOrPercent"
        },
        "maxUnavailable": {
          "$ref": "#/definitions/intOrPercent"
        }
      }
    },
    "enabled": {
      "type": "boolean",
      "description": "Read by a parent chart's dependency condition; ignored here."
    }
  }
}
